{
  "name": "nexus-erp-backend",
  "version": "0.0.1",
  "description": "Nexus ERP Backend - NestJS Modular Monolith",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "test": "ts-node -e \"import './src/modules/auth/auth.service.spec'; import './src/modules/finance-loan/finance-loan.service.spec'; import './src/modules/finance-loan/finance-loan.strict-branch.spec'; import './src/modules/finance-loan/finance-loan.lender.spec'; import './src/modules/finance-loan/finance-loan.controller.spec'; import './src/modules/finance-loan/funding-calculator.spec'; import './src/modules/finance-loan/finance-funding.service.spec'; import './src/modules/general-ledger/general-ledger.service.spec'; import './src/modules/general-ledger/general-ledger.controller.spec';\"",
    "test:integration": "ts-node -e \"import './src/modules/general-ledger/general-ledger.integration.spec'; import './src/modules/finance-loan/finance-loan.rbac.integration.spec'; import './src/modules/finance-loan/finance-loan.gl.integration.spec'; import './src/modules/finance-loan/finance-loan.lender.integration.spec';\"",
    "seed:rc-book-rules": "ts-node prisma/seed-rc-book-rules.ts",
    "seed:valuation-rules": "ts-node prisma/seed-valuation-rules.ts",
    "seed:admin": "ts-node prisma/seed-admin.ts",
    "seed:loans": "ts-node prisma/seed-loans.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.4.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "pdfjs-dist": "^6.5.438",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.10",
    "eslint": "^9.18.0",
    "prisma": "7.10.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "@types/multer": "^2.3.0"
  }
}