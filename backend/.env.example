# Nexus ERP - Backend Environment Configuration Example
# Copy this file to .env for local development: cp .env.example .env
# DO NOT commit real secrets or credentials to version control.

# Application Configuration
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=nexus_erp_dev_secret_key_must_be_at_least_32_characters_long

# Database Configuration (PostgreSQL 16)
# Note: ORM = Prisma 7. DATABASE_URL is the single connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/nexus_erp?schema=public

# Redis Configuration (Caching & Background Jobs)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Feature Flags
# Enable automatic General Ledger journal entry posting on loan disbursement (FINANCE_LOAN -> GL)
ENABLE_GL_POSTING=false

